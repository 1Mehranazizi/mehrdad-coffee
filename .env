DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_EMAIL="admin@mehrdadcoffee.ir"
ADMIN_PASSWORD="ChangeMe123!"

# Kavenegar SMS (leave empty in dev to just log OTP codes to the console)
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_OTP_TEMPLATE="mehrdadotp"

# Zarinpal (leave MERCHANT_ID empty to auto-use dev mock payment mode)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
NEXT_PUBLIC_BASE_URL="mehrdadcoffee.ir"

# Postex shipping quote (Mahex courier, courier_drop_off). Free shipping applies only to Kermanshah city.
# Leave POSTEX_API_KEY empty in dev to use a mock price; in production it is required.
POSTEX_API_KEY="postex_live_bee66050e8bTgMV52ogDH0gsAtMYIxP0k7apUueF"
POSTEX_AUTH_HEADER="x-api-key"
POSTEX_BASE_URL="https://api.postex.ir/api/v1"
POSTEX_ORIGIN_PROVINCE="کرمانشاه"
POSTEX_ORIGIN_CITY="کرمانشاه"
POSTEX_ORIGIN_CITY_CODE="487"   # optional: Postex city code of the sender (skips name lookup)
POSTEX_SERVICE_TYPE="EXPRESS"   # required by Postex; use a value valid for MAHEX
POSTEX_PAYMENT_TYPE="PREPAID"   # required by Postex; use a value from their docs
POSTEX_BOX_TYPE_ID="1"       # Postex box type id - required by the API
POSTEX_PROVINCES_PATH="/locality/provinces"
POSTEX_CITIES_PATH="/locality/cities"
POSTEX_PRICE_UNIT="rial"     # unit of prices in the quote response: rial | toman
